<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        xmlns:vm = "using:Client.ViewModels"
        xmlns:views="using:Client.Views"
        x:Class="Client.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WestcoastEducation Admin">
        <Window.DataTemplates>
                <DataTemplate DataType="vm:CoursesViewModel">
                        <views:CoursesView/>
                </DataTemplate>
                <DataTemplate DataType="vm:StudentsViewModel">
                        <views:StudentsView/>
                </DataTemplate>
                <DataTemplate DataType="vm:TeachersViewModel">
                        <views:TeachersView/>
                </DataTemplate>
        </Window.DataTemplates>
        <StackPanel>
                <Button Content="Courses" Command="{Binding GoToCoursesCommand}" />
                <Button Content="Students" Command="{Binding GoToStudentsCommand}" />
                <Button Content="Teachers" Command="{Binding GoToTeachersCommand}" />
                <ContentControl Content="{Binding CurrentView}" Margin="20"/>
        </StackPanel>


</Window>
