<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:models="using:WestcoastEducation.Models"
             x:Class="Client.Views.CoursesView"
             xmlns:vm="using:Client.ViewModels"
             x:DataType="vm:CoursesViewModel">
  <StackPanel Spacing="10">
    <TextBlock Text="{Binding PageTitle}" FontSize="24" />

    <!-- Form: add a new course, or edit the one selected in the list -->
    <StackPanel Spacing="8" MaxWidth="400" HorizontalAlignment="Left">
      <TextBox PlaceholderText="Course number" Text="{Binding FormCourseNumber}" />
      <TextBox PlaceholderText="Title" Text="{Binding FormTitle}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Weeks" VerticalAlignment="Center" Width="80" />
        <NumericUpDown Value="{Binding FormLengthInWeeks}" Minimum="1" Increment="1" FormatString="0" Width="150" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Start date" VerticalAlignment="Center" Width="80" />
        <CalendarDatePicker SelectedDate="{Binding FormStartDate}" Width="150" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Type" VerticalAlignment="Center" Width="80" />
        <ComboBox ItemsSource="{Binding CourseTypes}" SelectedItem="{Binding FormCourseType}" Width="150" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Add" Command="{Binding AddCourseCommand}" />
        <Button Content="Save changes" Command="{Binding UpdateCourseCommand}" />
        <Button Content="Delete" Command="{Binding DeleteCourseCommand}" />
        <Button Content="Clear" Command="{Binding ClearFormCommand}" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- List: click a course to load it into the form -->
    <ListBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:Course">
          <StackPanel Orientation="Horizontal" Spacing="20">
            <TextBlock Text="{Binding CourseNumber}" Width="60" />
            <TextBlock Text="{Binding Title}" Width="220" />
            <TextBlock Text="{Binding CourseType}" Width="80" />
            <TextBlock Text="{Binding LengthInWeeks, StringFormat='{}{0} weeks'}" Width="70" />
            <TextBlock Text="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd}'}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>
